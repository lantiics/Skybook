<link rel="stylesheet" href="/stylesheets/style.css">
<link rel="stylesheet" href="/stylesheets/instance.css">
<script src="/js/main.js"></script>
<script src="/js/instance.js"></script>
<meta name="instance-name" content="<%=ctx.instance%>">
<style>
  input {
    width: 100%;

  }

  .entry-submission {
    width: 90vw;
    margin-inline: 0px;
    /* display: none; */
  }

  textarea {
    width: 100%;


  }

  .entry {
    max-width: 100%;
    width: 100%;

  }

  :root {
    margin: 0px;
    padding: 0px;
  }

  body {
    margin: 0px;
    padding: 0px;
  }

  .entries {
    margin: 0 auto;
    align-items: center;
    padding: 0px;
    width: 90vw;
    max-width: 100%;
  }

  cap-widget {
    /* width: fit-content; */
    /* max-width: 100%; */
  }
</style>

<div style="display:flex;flex-direction: column;align-items: center;margin-block:1rem">


  <% if(status.submission_enabled.status) {%><%- include('../partials/instances/entry-form')%> <% } else {%><div class="instance-information" style="margin-block:2rem;">Submission is currently unavailable</div><%}%>
<!-- -->
<div>
  <div class="entries" id="entries">

    <% if (status.is_visible.status || ctx.elevated) { %>

  <% if (typeof posts !== 'undefined') { %>

  <%- include('../partials/instances/posts', {posts:posts,ctx:ctx})%>
  <% } else { %> <div class="entry">
    <div>no entries</div>
  </div> <% } %>
  <% } else { %>
  <div class="instance-information" style="margin-block:2rem;">Posts are currently not visible</div>
  <% } %>
</div>
</div>
</div>