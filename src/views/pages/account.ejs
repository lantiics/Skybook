<h1>hello, <%=ctx.user.name %></h1>
<div style="display: flex;flex-direction: column;place-items: center;gap: 1rem;text-align:center;">

  <div>
    <button onclick="(async ()=> {
      this.disabled=true;
      const res = await fetch('/api/auth/invitation', {method:'POST'})
      const body = await res.text()
      if (!res.ok) {
        createPopup('Failed to create invitation: '+errorStatus(res.status.toString()))
        setTimeout(()=> this.removeAttribute('disabled'),2500)
      } else {
        await navigator.clipboard.writeText(body)
        this.innerText=`Your invitation code is ${body}, it has been copied to your clipboard. make sure you save it. It can only be used three times.`
      }
    })()">Generate invitation</button>
  </div>

  <h2>Account settings</h2>
  <div>
    <h3>2fa</h3>
    <%-include('../partials/account/2fa')%>
  </div>
  <div>
    <h3>change password</h3>
    <%-include('../partials/account/change-password')%>
  </div>


  <div style="margin-block: 1.5rem;margin-top: 3rem;">
    <script>
      const tryDeleteAccount = async (btn) => {
        document.body.insertAdjacentHTML("beforebegin", await (await fetch(`/partials/delete-account`)).text())
      }
    </script>
    <button class="danger" id="deleteAccountBtn" onclick="tryDeleteAccount(this)">delete account</button>
  </div>

</div>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    setTimeout(() => {
      document.getElementById("deleteAccountBtn").removeAttribute("disabled");
    }, 2000);

  })
  const deleteFSPopup = () => {
    document.querySelector(".fs-popup-container").remove()
  }
</script>