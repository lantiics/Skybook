<div>
  <h2>change password</h2>
  <form class="authentication" action="/api/auth/<%=authAction%>" method="PATCH" id="authentication">
    <input type="text" name="username" title="arr" pattern="[a-zA-Z0-9_]+" placeholder="username" required />
    <input type="password" name="password" placeholder="current password" minlength="8" required />
    <input type="password" name="password" placeholder="new password" minlength="8" id="new-password" required />
    <input type="password" name="password" placeholder="confirm new password minlength=" 8" required" <% if (authAction === 'login') { %> <input type="text" name="otp" placeholder="2fa code (if applicable)" minlength="6" maxlength="6" pattern="[0-9]+" />

    <%  } %>
    <input type="submit" id="authorize" />
  </form>

</div>