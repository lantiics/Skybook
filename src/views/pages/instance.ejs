<h1><%=!ctx.elevated?ctx.instance+"'s guestbook":"your guestbook"%></h1>


<% if (ctx.elevated) { %> <%- include('../partials/instances/elevated-interface', {fields: fields})%> <% } %>
<% if (!ctx.elevated) {%>
<% if(status.submission_enabled.status) {%><%- include('../partials/instances/entry-form')%> <% } else {%><div class="information-box">Submission is currently unavailable</div> <%}%>
<% } %>
<!-- -->
<div>
  <div class="entries" id="entries">

    <% if (status.is_visible.status || ctx.elevated) { %>

    <% if (typeof posts !== 'undefined') { %>

    <%- include('../partials/instances/posts', {posts:posts,ctx:ctx})%>
    <% } else { %> <div class="entry">
      <div class="information-box">no entries</div>
    </div> <% } %>
    <% } else { %>
    <div class="information-box">Posts are currently not visible</div>
    <% } %>
  </div>
</div>