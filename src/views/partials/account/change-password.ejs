    <form class="authentication" action="/api/auth/password" method="post" id="authentication">
      <fieldset>
        <input type="text" id="currUNameC" name="username" title="arr" pattern="[a-zA-Z0-9_]+" placeholder="username" required />
        <input type="password" id="currPwC" name="oldPassword" placeholder="current password" minlength="8" required />
        <input type="password" id="newPwC" name="newPassword" placeholder="new password" minlength="8" id="new-password" required />
        <input type="password" id="confirmPwC" placeholder="confirm new password" minlength=" 8" required /> <input type="text" name="otp" placeholder="2fa code (if applicable)" minlength="6" maxlength="6" pattern="[0-9]+" />

        <br />
        <input type="submit" id="pwc-authorize" disabled />
      </fieldset>
    </form>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const newPwElem = document.getElementById("newPwC")
        const pwConfirmationElem = document.getElementById("confirmPwC");
        const incorrectElems = new Set([]);
        const pwChangeChecker = () => {
          if (document.getElementById("currPwC").value.length < 8) {
            document.getElementById("currPwC").style = "--border-color:var(--danger)"
            incorrectElems.add("cpwc")
          } else {
            document.getElementById("currPwC").removeAttribute("style")
            incorrectElems.delete("cpwc")
          }

          if (newPwElem.value.length > 8) {
            newPwElem.removeAttribute("style")
            incorrectElems.delete("npwc")
          } else {
            newPwElem.style = "--border-color:var(--danger)"
            incorrectElems.add("npwc")
          }
          if (pwConfirmationElem.value !== newPwElem.value || pwConfirmationElem.value.length < 8) {
            pwConfirmationElem.style = "--border-color:var(--danger)"
            incorrectElems.add("cfpwc")

          } else {
            pwConfirmationElem.removeAttribute("style")
            incorrectElems.delete("cfpwc")
          }
          if (document.getElementById("currUNameC").value !== "<%=ctx.user.name%>") {
            document.getElementById("currUNameC").style = "--border-color:var(--danger)"
            incorrectElems.add("cunc")
          } else {
            document.getElementById("currUNameC").removeAttribute("style")
            incorrectElems.delete("cunc")
          }
          if ([...incorrectElems].length === 0) {
            document.getElementById("pwc-authorize").removeAttribute("disabled")
          } else {
            document.getElementById("pwc-authorize").disabled = true
          }
          console.log(incorrectElems, [...incorrectElems].length)
        }
        document.getElementById("currUNameC").addEventListener("keyup", pwChangeChecker)
        document.getElementById("currPwC").addEventListener("keyup", pwChangeChecker)
        newPwElem.addEventListener("keyup", pwChangeChecker)
        pwConfirmationElem.addEventListener("keyup", pwChangeChecker)
      })
    </script>