<style>
  html,
  body {
    min-height: 100%;
    margin: 0px;
  }

  html {
    scrollbar-gutter: stable;
  }

  .container {
    width: 50%;
    min-height: 40vh;
    margin: 0 auto;
    margin-top: 1rem;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 1rem;
    @media only screen and (max-width: 600px) {
      width: 94%;
    }
  }

  .header-announcement {
    background-color: var(--important);
    color:var(--on-important);
    border-radius: var(--primary-brad);
    padding-inline:6px;
    width: fit-content;
    place-self: center;
    text-align: center;
    place-content: center;
    font-weight: bold;
    min-height: 2rem;
    margin-bottom:0.5rem;
    margin-inline: auto;
    @media only screen and (max-width:600px) {
      width:90%;
    }
  }

  header {
    margin-top:0.5rem;
    padding-block:0.5rem;
    border-bottom: 2px solid color-mix(in hsl, white 5%, transparent 95%);
    width: 100%;
    color: var(--color);
    @media only screen and (max-width:600px) {border-bottom:none}
  }



  header nav {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content:center;
    align-items: center;
    align-self: center;
    margin: 0 auto;
    width: 60%;
    gap:8px;
    color: var(--color);
    @media only screen and (max-width:600px) {
      flex-direction: column;
      width:90%;
      height:85%;
      justify-content: start;
      place-content: top;
    }
  }

  .nav-part {
    gap:8px;
    display: flex;
    @media only screen and (max-width:600px) {
      gap:8px;
      display:grid;
      grid-template-columns: repeat(1, 1fr);
      width:100%;
    }
  }

  .header-btn {
    background-color:var(--primary-container);
  }

  .auth-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-left: auto;
    @media only screen and (max-width:600px) {
      display:grid;
      grid-template-columns: repeat(1, 1fr);
      width:100%;
      align-self: end;
      margin-left:unset;
    }
  }

  #menu {
    z-index: 9;
    @media only screen and (max-width: 600px) {
      background: var(--bg-color);
      padding-block: 1rem;
      position: fixed;
      width: min(60vw, 260px);
      overflow-y: auto;
      height: 100vh;
      padding-left: 15px;
      transform: translateX(100%);
      right: 0;
      top: 0;
      max-width: none !important;
      transition: 125ms cubic-bezier(0.77, 0, 0.175, 1);
    }
  }
  #menu-button {
    position: fixed;
    right:1rem;
    bottom:1rem;
    z-index:10;
    @media only screen and (min-width:600px) {
      display:none;
      content-visibility:hidden;
    }
  }



  main {
    border-radius: var(--primary-brad);
    display: flex;
    flex-direction: column;
    align-items: top;
    min-height: 30vh;
    gap: 1rem;
    padding: 0.5rem;
    contain: layout print;
  }

  footer {
    content-visibility: auto;
    display: flex;
    border-top: 1px solid color-mix(in hsl, white 10%, transparent 90%);
    width: fit-content;
    justify-content: center;
    padding: 0.5rem;padding-inline: 3rem;
    justify-self: center;
    margin-bottom: 1rem;
    margin-top: 1rem;
    margin-inline:auto;
  }
</style>

<script>
const toggleNav = () => {
    if (!document.getElementById("menu").getAttribute("style")) {
    // openNavButton()
    document.getElementById("menu").style.transform = "translateX(0)";
    document.getElementById("menu-button").style.backgroundColor =
      "var(--selected)";
  } else {
    // closeNavButton()
    document.getElementById("menu").removeAttribute("style");
    document.getElementById("menu-button").removeAttribute("style");
  }
}
</script>
<link rel="stylesheet" href="/stylesheets/style.css?v=<%=assetVersion%>" !important />

<% if (ctx && ctx.instance) { %>
<link rel="stylesheet" href="/stylesheets/instance.css?v=<%=assetVersion%>">
<meta name="instance-name" content="<%=ctx.instance%>" />
<script src="/js/instance.min.js?v=<%=assetVersion%>"></script>
<%}%>
<% if (ctx && ctx.elevated) {%>
<link rel="stylesheet" href="/stylesheets/elevated-instance.css?v=<%=assetVersion%>" />
<% }%>


<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="canonical" href="<%=canonical%>" />
<title><%=title%></title>
<meta property="og:title" content="<%=ctx?.instance?ctx.instance+'\'s guestbook - Skybook':'Skybook - Your fully open source guestbook'%>">
<meta name="description" content="Skybook is a fully open source guestbook service with an extended focus on privacy and security. You can create and moderate a guestbook for your online persona with ease.">
<meta property="og:description" content="Skybook is a fully open source guestbook hosting service with an extended focus on privacy and security. You can quickly and easily create and moderate a guestbook for your online persona, website, or similar.">
<meta property="og:site_name" content="Skybook">

<script src="/js/main.min.js?v=<%=assetVersion%>"></script>