<style>
  html,
  body {
    min-height: 100%;
    margin: 0px;
  }

  html {
    scrollbar-gutter: stable;
  }



  .container {
    width: 50%;
    min-height: 40vh;
    margin: 0 auto;
    margin-top: 1rem;
    display: grid;
    /* grid-template-columns: 250px 1fr; */
    grid-template-rows: auto 1fr auto;
    gap: 1rem;

    @media only screen and (max-width: 600px) {
      width: 94%;
    }
  }

  .header-announcement {
    /* border: 1px groove var(--border-color); */
    
    background-color: var(--important);
    color:var(--on-important);
    border-radius: .5rem;
    /* width: 50vw; */
    margin-inline: 0.5rem;
    padding-inline:6px;
    width: fit-content;
    place-self: center;
    text-align: center;
    place-content: center;
    font-weight: bold;
    min-height: 2rem;
    /* position: relative; */
    
  }

  .information-box {
    border: 2px groove var(--border-color);
    padding: 6px;
    border-radius: var(--secondary-brad);
    background-color: var(--tertiary-container);
    font-size: large;
    font-weight: bold;
    height: fit-content;
    text-overflow: clip;
    
    position: relative;
  }

  header {


    /* background-color: var(--important); */
    border-bottom: 2px solid color-mix(in hsl, white 5%, transparent 95%);
    /* border-radius: var(--primary-brad); */
    width: 100%;
    
    
    /* height: 0px; */
    color: var(--color);
  }
  header .header-content {
    display: flex;
    flex-direction: column;
    padding-block:0.9rem;
    gap: 1rem;
    
  }

  header nav {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content:center;
    align-items: center;
    align-self: center;
    width: 60%;
    gap:8px;
    color: var(--color);
    @media only screen and (max-width:600px) {width:90%}
    
  }


  .auth-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;

  }

  main {
    border-radius: var(--primary-brad);
    /* border: 1px groove var(--border-color); */
    /* width: 100%; */
    display: flex;
    flex-direction: column;
    align-items: top;
    min-height: 30vh;
    gap: 1rem;
    padding: 0.5rem;
    contain: layout print;
  }

  footer {
    content-visibility: auto;
    /* background-color: var(--border-color); */
    /* border-radius: var(--secondary-brad); */
    display: flex;
    border-top: 1px solid color-mix(in hsl, white 10%, transparent 90%) ;
    width: fit-content;
    
    justify-content: center;
    padding: 0.5rem;padding-inline: 3rem;
    justify-self: center;
    margin-bottom: 1rem;
    margin-top: 1rem;
    margin-inline:auto;
    /* height: 3rem; */
  }
</style>

<link rel="stylesheet" href="/stylesheets/style.css?v=<%=assetVersion%>" !important />

<% if (ctx && ctx.instance) { %>

<link rel="stylesheet" href="/stylesheets/instance.css?v=<%=assetVersion%>">
<%}%>
<% if (ctx && ctx.elevated) {%>
<link rel="stylesheet" href="/stylesheets/elevated-instance.css?v=<%=assetVersion%>" />
<% }%>


<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title><%=title%></title>
<meta property="og:title" content="<%=ctx?.instance?ctx.instance+'\'s guestbook - Skybook':'Skybook'%>">
<meta property="og:description" content="Skybook is a fully open source guestbook hosting service which can optionally be self-hosted with ease.">
<meta property="og:site_name" content="Skybook">





<meta name="instance-name" content="<%=ctx.instance%>" />
<script src="/js/instance.js?v=<%=assetVersion%>"></script>


<script src="/js/main.js?v=<%=assetVersion%>"></script>