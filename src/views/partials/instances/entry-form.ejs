<% if (status.submission_enabled || ctx.elevated ) {%>
<% if (captcha.implementation==='cap') { %><script src="https://cdn.jsdelivr.net/npm/cap-widget@latest"></script> <% } %>
<div>
  <form class="entry-submission" id="submission-form" action="/api/<%=ctx.instance%>" method="POST">
    <fieldset id="fs">
      <label for="author">your name: </label>
      <input name="author" id="author" placeholder="anonymous">
      <% for (field of fields) { if (!['content','author'].includes(field.name)) {%><label for="field-<%=field.name%>"><%=field.name%>:</label><input name="<%=field.name%>" id="field-<%=field.name%>" placeholder="<%=field.name%>" <% if (field.is_required) {%> required <% } %>> <% } } %>
      <label for="content">message:</label>
      <textarea id="content" name="content" placeholder="say something!" required></textarea>
      <% if (captcha.implementation==='cloudflare') {%> <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"></script><%}%>
      <% if (captcha.implementation) {%> <script>
        const appendWidget = () => {
          document.querySelectorAll('[data-unsolvedcaptcha="disabled"]').forEach(e => e.disabled = true);
          document.querySelectorAll('#captcha').forEach(e => e.remove());

          <% if (captcha.implementation==='cap') {%>
          const widget = Object.assign(document.createElement("<%=captcha.implementation==="cap"?'cap-widget':'div'%>"), {
            required: true,
            style: "place-self:center;margin-top:0.5rem",
            id: "captcha"
          })

          widget.setAttribute("data-cap-api-endpoint", "/api/captcha/<%=captcha.site_key%>");
          widget.setAttribute("onsolve", `document.querySelectorAll('[data-unsolvedcaptcha="disabled"]').forEach(e=>e.removeAttribute("disabled"));`)


          document.getElementById("fs").append(widget) <% } else if (captcha.implementation==='cloudflare') {%>

          turnstile.render('#turnstile', {
            sitekey: '<%=captcha.site_key%>',
            theme: "dark",
            callback: function() {
              document.querySelectorAll('[data-unsolvedcaptcha="disabled"]').forEach(e => e.removeAttribute("disabled"));
            }
          })

          <%}%>
      }
      const initSolving = () => {
        <% if (captcha.implementation==='cap') {%>

            (async () => {
              try {
                const cap = new Cap({
                  apiEndpoint: "/api/captcha/<%=captcha.site_key%>"
                });

                const solution = await cap.solve();
                if (solution.success) {
                  document.getElementById("submission-form").append(Object.assign(document.createElement("input"), {
                    type: "hidden",
                    name: "cap-token",
                    value: solution.token,
                    id: "captcha"
                  }));
                  document.querySelectorAll('[data-unsolvedcaptcha="disabled"]').forEach(e => e.removeAttribute("disabled"));
                } else {
                  console.log("failed")
                  appendWidget()

                }
              } catch (e) {
                appendWidget()
              }
            })()
          <%} else {%>appendWidget() <% }%>

        }
        const handler = function(e) {
          initSolving();
          this.removeEventListener('keydown', handler)
        }
        document.getElementById("content").addEventListener("keydown", handler)
      </script><%}%>
      <div id="turnstile"></div>
      
      <input type="submit" class="success" value="Submit" id="submit-entry" data-unsolvedcaptcha="disabled" disabled/>
    </fieldset>
  </form>

</div>

      <% } else { %>
      <div>submission disabled</div>
      <% } %>