<div class="actions">
  <% if ((post.authenticated_user_identifier==(ctx.user ? ctx.user.identifier:'not an identifier'))||ctx.elevated) { %>
  <button onclick="actOnPost(this.parentNode.parentNode,this)" data-action="delete" class="danger" <% if (post.sys_lock && !ctx.superAdmin) {%> disabled="true" <% }%>>delete</button>
  <% if (ctx.elevated) { %>

  <% if (post.authenticated_user_identifier !== ctx.user.identifier && post.ip_hash) {%><button onclick="actOnPost(this.parentNode.parentNode,this)" data-action="<% if(post.creator_blocked)  {%>unblock<% } else {%>block<%}%>" <% if (post.sys_lock && !ctx.superAdmin) {%> disabled=" true" <% }%>><% if(post.creator_blocked)  {%> unblock <% } else {%>block<%}%> </button> <%}%>
    <button onclick="actOnPost(this.parentNode.parentNode,this)" data-action="visibility" <% if (post.sys_lock && !ctx.superAdmin) {%> disabled=" true" <% }%>><%=post.is_visible?"hide":"unhide"%></button>
    <button onclick="actOnPost(this.parentNode.parentNode,this)" data-action="highlight" <% if (post.sys_lock && !ctx.superAdmin) {%> disabled=" true" <% }%>><%=post.is_highlighted?"un-highlight":"highlight"%></button>
    <button onclick="actOnPost(this.parentNode.parentNode,this)" data-action="pin" <% if (post.sys_lock && !ctx.superAdmin) {%> disabled=" true" <% }%>><%=post.is_pinned?"unpin":"pin"%></button>
    <% if (ctx.superAdmin) { %> <button onclick="actOnPost(this.parentNode.parentNode,this)" data-action="lock" <% if (post.sys_lock && !ctx.superAdmin) {%> disabled="true" <% }%>><%-post.sys_lock?"unlock":"lock" %></button> <% } %>
    <% if (post.is_queued) { %>
    <button onclick="actOnPost(this.parentNode.parentNode,this)" data-action="approve" <% if (post.sys_lock && !ctx.superAdmin) {%> disabled="true" <% }%>>approve</button>
    <% } %>
    <button <%if (!post.reply){%>onclick="reply(this.parentNode.parentNode)" <%} else {%>onclick="deleteReply(this)" <%}%>><%=!post.reply?"reply":"delete reply"%></button>
      <% if (post.flag_count) {%><button onclick="actOnPost(this.parentNode.parentNode,this)" data-action="clear-flags">clear flags</button> <%}%>
    <% if (!post.sys_lock&&ctx.elevated&&!post.postedByRequestor) {%><button onclick="actOnPost(this.parentNode.parentNode,this)" data-action="toggle-flagging" <% if(post.authenticated_user_identifier&&post.authenticated_user_identifier===ctx.user.identifier) {%>disabled <%}%>><%=post.can_flag?"disable flagging":"enable flagging"%></button><%} %>

        <% } %>
        <% } %>
        <% if(status.submission_enabled.status||ctx.elevated) {%>
        <% if (status.flagging_enabled&&post.can_flag&&!ctx.elevated&&!post.postedByRequestor) {%> <button onclick="actOnPost(this.parentNode.parentNode,this)" data-action="flag">flag post</button> <%}%>
  <% }%>
</div>