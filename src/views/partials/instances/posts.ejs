<% for (post of posts) {%>
<%- include('./post',{post:post,ctx:ctx}) %>
<% } %>
<div class="page-switcher">
  <a <% if (page===0) {%>disabled <%} else {%> href="?p=<%=page-1%>" <%}%>><button id="prevPage" <% if (page===0) {%>disabled <%}%> >prev</button></a>
  <a <% if (page === pages) {%> disabled <%} else {%> href="?p=<%=page+1%>" <%}%>><button id="nextPage" <% if (page === pages) {%> disabled <%}%> >next</button></a>
</div>