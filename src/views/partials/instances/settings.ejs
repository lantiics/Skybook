<div class="instance-switches">
  <div class="instance-switch-container">
    <span>Visible</span>
    <input type="checkbox" class="instance-switch" name="visibility" id="instanceVisibility" data-action="visibility" <% if (status.is_visible.status) {%>checked <% } %> onclick="toggleStatus(this)">
  </div>
  <div class="instance-switch-container">
    <span>Submission</span>
    <input type="checkbox" class="instance-switch" name="submission" id="instanceSubmission" data-action="submission" <% if (status.submission_enabled.status) {%>checked <% } %> onclick="toggleStatus(this)">
  </div>
  <div class="instance-switch-container">
    <span>Approval</span>
    <input type="checkbox" class="instance-switch" name="approval" id="instanceApproval" data-action="approval" <% if (status.approval_required.status) {%>checked <% } %> onclick="toggleStatus(this)">
  </div>
  <div class="instance-switch-container">
    <span>Queue filtered posts</span>
    <input type="checkbox" class="instance-switch" name="queueFiltered" id="instanceQueueFiltered" data-action="queue-filtered" <% if (status.queue_on_filtered.status) {%>checked <% } %> onclick="toggleStatus(this)">
  </div>
</div>
<label for="queueFlagThreshold">Number of times a post has to be flagged before being automatically placed into a queue:</label>
<input id="queueFlagThreshold" value="<%=status.queue_flags_threshold.status%>" type="number">
<br />
<div>
  <span>Receive a notification when a new post is created</span>
  <div>
    <label for="available-notification-services">Service:</label>
    <select name="available-notification-services"   id="available-notification-services">
      <% for (service of skybook.instance_notification_services) {%><option value="<%=service%>" <%= service==notifications.service?"selected":""%>><%=service%></option> <%}%>
    </select>
    <label for="notification-service-url">URL:</label>
    <input id="notification-service-url" placeholder="<%=notifications.enabled?'endpoint URL':'notifications unavailable'%>" <% if (notifications.enabled) {%> value="<%=notifications.url%>"<%}%>>
  </div>
</div>