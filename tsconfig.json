{
  "compilerOptions": {

    "paths": {
      "root/*":["./*"],
      "@/*":["./src/*"],
      "@domain/*":["./src/domain/*"],
      "@jobs/*":["./src/jobs/*"],
      "@middleware/*":["./src/middleware/*"],
      "@public/*":["./src/public/*"],
      "@routes/*":["./src/routes/*"],
      "@startup/*":["./src/startup/*"],
      "@views/*":["./src/views/*"],
      "@types/*":["./src/types/*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "target": "ES2025",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2025"],

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "types": ["bun-types", "express"],

    "outDir": "dist",
    "rootDir": "src",

    "resolveJsonModule": true,
    "isolatedModules": true,
    
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/app.js", "src/app.js", "src/app.js"],
  "exclude": ["node_modules", "dist"]
}